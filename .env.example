# Copy to .env and edit. Sourced by every script here; .env is gitignored.

# This host's LAN address. wayvnc and the noVNC server bind to it specifically,
# never 0.0.0.0 -- RFB carries no transport encryption in this setup.
HOST_IP=10.0.0.10

# Which DRM connector to force on. MUST be DisplayPort: an EDID with no CEA-861
# block makes the driver apply the 165 MHz single-link DVI ceiling, which
# rejects 2160x1620@60. `ls /sys/class/drm/` to see yours.
CONN=DP-1
CARD=card0
DRI=0

# Mode handed to the forced connector. Defaults are the iPad 8 panel.
W=2160
H=1620
R=60
SCALE=2

# Where the output sits in the compositor's layout, in logical pixels.
# Centred below a 2560x1440 monitor at 0,0: (2560-1080)/2 = 740, y = 1440.
POS_X=740
POS_Y=1440

# Optional. The iPad is found by cached address, then this MAC in the ARP table,
# then a port-22 sweep. iOS uses a private, rotatable Wi-Fi MAC, so this is a
# hint and not an identity; leave it empty if you do not care.
IPAD_MAC=
# Set to skip discovery entirely.
#IPAD_HOST=
