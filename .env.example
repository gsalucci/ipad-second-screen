# Copy to .env and edit.

# This host's LAN address. The VNC server binds to it specifically rather than
# 0.0.0.0, because RFB carries no transport encryption.
HOST_IP=10.0.0.10

# The DRM connector to force on -- `ls /sys/class/drm/` to list yours. Use a
# DisplayPort connector: see "Why DisplayPort" in the README.
CONN=DP-1
CARD=card0
DRI=0

# The mode handed to the connector. The defaults are the iPad 8 panel; for an
# iPad Air/Pro use that panel's native resolution instead.
W=2160
H=1620
R=60
SCALE=2

# Where the monitor sits in the niri layout, in logical pixels. To centre it
# below a 2560x1440 monitor at 0,0: (2560 - W/SCALE) / 2, and y = 1440.
POS_X=740
POS_Y=1440

# VNC
PORT=5901
FPS=30

# Optional. Skip discovery by pinning the tablet's address:
#IPAD_HOST=10.0.0.20
# Or help discovery along with its Wi-Fi MAC. iOS rotates private MACs, so this
# is only a hint; leave it empty to fall back to scanning.
IPAD_MAC=

# SSH key authorised on the iPad.
#IPAD_KEY=~/.ssh/id_ed25519_ipad

# Set to 0 to bring the monitor up without touching the tablet.
AUTOCONNECT=1
